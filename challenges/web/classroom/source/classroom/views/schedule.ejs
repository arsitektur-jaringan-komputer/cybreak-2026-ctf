<%- include('partials/header') %>
<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">🗓️ Weekly Schedule</h1>
      <p class="text-gray-500 mt-1">Class timetable for the week</p>
    </div>
  </div>

  <% if (user.role === 'lecturer' || user.role === 'admin') { %>
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <h3 class="font-semibold text-gray-900 mb-4">Add Schedule Entry</h3>
    <form action="/classroom/schedule" method="POST" class="grid grid-cols-1 md:grid-cols-5 gap-3">
      <select name="day_of_week" required
        class="px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 outline-none bg-white">
        <% days.forEach(function(d) { %><option value="<%= d %>"><%= d %></option><% }) %>
      </select>
      <input type="time" name="start_time" required
        class="px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 outline-none">
      <input type="time" name="end_time" required
        class="px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 outline-none">
      <input type="text" name="subject" placeholder="Subject" required
        class="px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 outline-none">
      <button type="submit" class="bg-primary-600 text-white px-4 py-2.5 rounded-lg hover:bg-primary-700 transition-colors font-medium text-sm">
        Add
      </button>
    </form>
  </div>
  <% } %>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
    <% days.forEach(function(d) { %>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
      <h3 class="font-semibold text-gray-900 mb-3 pb-2 border-b border-gray-100"><%= d %></h3>
      <% if (grouped[d].length === 0) { %>
      <p class="text-sm text-gray-400">No classes</p>
      <% } else { %>
      <div class="space-y-2">
        <% grouped[d].forEach(function(s) { %>
        <div class="bg-primary-50 border border-primary-100 rounded-lg p-3">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs font-medium text-primary-700"><%= s.start_time %> - <%= s.end_time %></span>
            <% if (user.role === 'lecturer' || user.role === 'admin') { %>
            <form action="/classroom/schedule/<%= s.id %>/delete" method="POST" onsubmit="return confirm('Remove this entry?');">
              <button type="submit" class="text-xs text-red-400 hover:text-red-600">✕</button>
            </form>
            <% } %>
          </div>
          <p class="text-sm font-medium text-gray-900"><%= s.subject %></p>
        </div>
        <% }) %>
      </div>
      <% } %>
    </div>
    <% }) %>
  </div>
</div>
<%- include('partials/footer') %>
