<%- include('partials/header') %>
<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">User Management</h1>
      <p class="text-gray-500 mt-1">Manage all system users</p>
    </div>
    <a href="/admin/dashboard" class="text-primary-600 hover:text-primary-800 text-sm font-medium">← Admin Dashboard</a>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-gray-50">
          <tr class="text-left text-gray-600">
            <th class="px-6 py-3 font-medium">ID</th>
            <th class="px-6 py-3 font-medium">Username</th>
            <th class="px-6 py-3 font-medium">Role</th>
            <th class="px-6 py-3 font-medium">Created</th>
            <th class="px-6 py-3 font-medium text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(function(u) { %>
          <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
            <td class="px-6 py-3 text-gray-700"><%= u.id %></td>
            <td class="px-6 py-3 font-medium text-gray-900"><%= u.username %></td>
            <td class="px-6 py-3">
              <span class="text-xs px-2 py-0.5 rounded-full font-medium
                <%= u.role === 'admin' ? 'bg-red-100 text-red-700' : (u.role === 'lecturer' ? 'bg-blue-100 text-blue-700' : 'bg-green-100 text-green-700') %>">
                <%= u.role %>
              </span>
            </td>
            <td class="px-6 py-3 text-gray-500"><%= new Date(u.created_at).toLocaleDateString() %></td>
            <td class="px-6 py-3 text-right">
              <% if (u.role !== 'admin' && u.role !== 'lecturer') { %>
              <form action="/admin/users/<%= u.id %>/delete" method="POST" onsubmit="return confirm('Delete user <%= u.username %>?');" style="display:inline;">
                <button type="submit" class="text-xs text-red-500 hover:text-red-700 font-medium">Delete</button>
              </form>
              <% } else { %>
              <span class="text-xs text-gray-400">Protected</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
