<%- include('partials/header') %>
<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">System Configuration</h1>
      <p class="text-gray-500 mt-1">View legacy backup configuration files</p>
    </div>
    <a href="/admin/dashboard" class="text-primary-600 hover:text-primary-800 text-sm font-medium">← Admin Dashboard</a>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <p class="text-sm text-gray-600 mb-6">
      These are legacy configuration backup files from the previous system version.
      They were supposed to be removed after migration to the database but may still contain useful information.
    </p>

    <% if (configs.length === 0) { %>
    <div class="bg-amber-50 border border-amber-200 rounded-lg p-4">
      <p class="text-sm text-amber-700">No backup configuration files found in <code>/app/backup/</code>.</p>
    </div>
    <% } else { %>
    <div class="space-y-2">
      <% configs.forEach(function(cfg) { %>
      <div class="flex items-center gap-3 p-4 bg-gray-50 rounded-lg border border-gray-200">
        <span class="text-2xl">📋</span>
        <div>
          <p class="text-sm font-mono text-gray-900 font-medium"><%= cfg.name %></p>
          <p class="text-xs text-gray-500">Legacy backup - migrated to database</p>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</div>
<%- include('partials/footer') %>
