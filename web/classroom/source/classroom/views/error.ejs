<%- include('partials/header') %>
<div class="flex min-h-[60vh] items-center justify-center">
  <div class="text-center max-w-lg">
    <div class="text-6xl mb-4">
      <%= typeof message !== 'undefined' && message.includes('not found') ? '🔍' : '⚠️' %>
    </div>
    <h1 class="text-2xl font-bold text-gray-900 mb-2">
      <%= typeof message !== 'undefined' && message.includes('not found') ? 'Not Found' : 'Error' %>
    </h1>
    <p class="text-gray-600 mb-6"><%= typeof message !== 'undefined' ? message : 'An unexpected error occurred.' %></p>
    <div class="space-x-3">
      <a href="/dashboard" class="inline-block bg-primary-600 text-white px-6 py-2.5 rounded-lg hover:bg-primary-700 transition-colors font-medium text-sm">
        Back to Dashboard
      </a>
      <a href="javascript:history.back()" class="inline-block bg-gray-200 text-gray-700 px-6 py-2.5 rounded-lg hover:bg-gray-300 transition-colors font-medium text-sm">
        Go Back
      </a>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
