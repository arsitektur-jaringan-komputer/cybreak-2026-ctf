<%- include('partials/header') %>
<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">System Modules</h1>
      <p class="text-gray-500 mt-1">Load and execute system maintenance modules</p>
    </div>
    <a href="/admin/dashboard" class="text-primary-600 hover:text-primary-800 text-sm font-medium">← Admin Dashboard</a>
  </div>

  <!-- Available Modules -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <h3 class="font-semibold text-gray-900 mb-4">Available Modules</h3>
    <% if (modules.length === 0) { %>
    <p class="text-sm text-gray-500">No modules found in the modules directory.</p>
    <% } else { %>
    <div class="space-y-2">
      <% modules.forEach(function(mod) { %>
      <a href="<%= mod.path %>" class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-200 hover:border-primary-300 hover:bg-primary-50 transition-all">
        <div class="flex items-center gap-3">
          <span class="text-lg">📄</span>
          <span class="text-sm font-medium text-gray-900"><%= mod.name %></span>
        </div>
        <span class="text-xs text-primary-600 font-medium">Load →</span>
      </a>
      <% }) %>
    </div>
    <% } %>
  </div>

  <!-- Manual Module Loader -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <h3 class="font-semibold text-gray-900 mb-4">Load Module Manually</h3>
    <form action="/admin/modules" method="GET" class="space-y-4">
      <div>
        <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Module Path</label>
        <input type="text" id="name" name="name" value="<%= typeof loadedModule !== 'undefined' ? loadedModule : '' %>"
          class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none font-mono text-sm"
          placeholder="system_info.js">
        <p class="text-xs text-gray-400 mt-1">Module files are loaded from the <code>modules/</code> directory.</p>
      </div>
      <div class="flex items-center gap-3">
        <label class="flex items-center text-sm text-gray-600">
          <input type="checkbox" name="debug" value="true" <%= typeof debug !== 'undefined' && debug ? 'checked' : '' %> class="mr-2 rounded border-gray-300 text-amber-600 focus:ring-amber-500">
          Debug mode
        </label>
      </div>
      <button type="submit"
        class="bg-primary-600 text-white px-6 py-2.5 rounded-lg hover:bg-primary-700 transition-colors font-medium text-sm">
        Execute Module
      </button>
    </form>
  </div>

  <!-- Module Result -->
  <% if (result) { %>
  <div class="bg-green-50 border border-green-300 rounded-xl p-6">
    <h3 class="font-semibold text-green-900 mb-3">✅ Module Output</h3>
    <pre class="text-xs text-green-800 bg-green-100 rounded-lg p-4 border border-green-200 overflow-x-auto whitespace-pre-wrap"><%= JSON.stringify(result, null, 2) %></pre>
  </div>
  <% } %>
</div>
<%- include('partials/footer') %>
