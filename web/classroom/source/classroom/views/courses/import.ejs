<%- include('partials/header') %>
<div class="max-w-3xl mx-auto space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Import Students (XML)</h1>
    <p class="text-gray-500 mt-1">Import student roster data from XML format. The system parses <code>&lt;student&gt;</code> elements from the provided XML.</p>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <h3 class="font-semibold text-gray-900 mb-4">Expected XML Format</h3>
    <pre class="bg-gray-50 border border-gray-200 rounded-lg p-4 text-xs text-gray-700 overflow-x-auto">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;roster&gt;
  &lt;student name="John Doe"&gt;A+ student&lt;/student&gt;
  &lt;student name="Jane Smith"&gt;Needs improvement&lt;/student&gt;
&lt;/roster&gt;</pre>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <form action="/courses/import" method="POST" class="space-y-5">
      <div>
        <label for="xmlData" class="block text-sm font-medium text-gray-700 mb-1">XML Data</label>
        <textarea id="xmlData" name="xmlData" rows="10" required
          class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none font-mono text-sm"
          placeholder="Paste your XML data here..."></textarea>
      </div>
      <button type="submit"
        class="bg-primary-600 text-white px-6 py-2.5 rounded-lg hover:bg-primary-700 transition-colors font-medium text-sm">
        Import Students
      </button>
    </form>
  </div>

  <% if (result) { %>
  <div class="bg-green-50 border border-green-300 rounded-xl p-6">
    <h3 class="font-semibold text-green-900 mb-3">✅ Import Successful</h3>
    <p class="text-sm text-green-700 mb-3">
      Imported <strong><%= result.totalImported %></strong> student(s) at <%= result.timestamp %>
    </p>

    <% if (result.students.length > 0) { %>
    <div class="space-y-2">
      <h4 class="text-sm font-semibold text-green-800">Parsed Students:</h4>
      <% result.students.forEach(function(s) { %>
      <div class="bg-white rounded-lg p-3 border border-green-200">
        <p class="text-sm font-medium text-gray-900"><%= s.name %></p>
        <% if (s.detail) { %>
        <pre class="text-xs text-gray-600 mt-1 whitespace-pre-wrap bg-gray-50 p-2 rounded border border-gray-200"><%= s.detail %></pre>
        <% } %>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>
  <% } %>
</div>
<%- include('partials/footer') %>
