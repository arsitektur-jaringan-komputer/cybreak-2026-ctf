<%- include('partials/header') %>
<div class="max-w-3xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <a href="/notes" class="text-primary-600 hover:text-primary-800 text-sm font-medium flex items-center gap-1">
      ← Back to Notes
    </a>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="flex items-start justify-between mb-4">
      <h1 class="text-2xl font-bold text-gray-900"><%= note.title %></h1>
      <span class="text-xs px-2 py-0.5 rounded-full font-medium
        <%= note.is_private ? 'bg-yellow-100 text-yellow-700' : 'bg-green-100 text-green-700' %>">
        <%= note.is_private ? '🔒 Private' : '🌐 Public' %>
      </span>
    </div>

    <div class="flex items-center text-sm text-gray-500 mb-6 pb-4 border-b border-gray-100">
      <span><%= new Date(note.created_at).toLocaleString() %></span>
    </div>

    <div class="prose max-w-none">
      <pre class="text-gray-800 whitespace-pre-wrap font-sans text-sm leading-relaxed bg-gray-50 rounded-lg p-4 border border-gray-200"><%= note.content || '(No content)' %></pre>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
